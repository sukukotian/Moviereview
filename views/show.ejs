<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show in Detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h3>Show review and Rating in Detail</h3>
    <h4>Movie Id :<%=review.id%></h4>
    <div class="content">
        <h2>Movie name: <%=review.moviename%></h2>
        <h3>Username: <%=review.username%></h3>
        <h4>Rating: <%=review.rating%></h4>
        <h4>Review: <%=review.review%></h4>
    </div>
</body>
</html>